{
    "name": "supersplat",
    "version": "3.8.1",
    "author": "PlayCanvas<support@playcanvas.com>",
    "homepage": "https://playcanvas.com/supersplat/editor",
    "description": "3D Gaussian Splat Editor",
    "keywords": [
        "playcanvas",
        "ply",
        "gaussian",
        "splat",
        "editor"
    ],
    "license": "MIT",
    "main": "index.js",
    "scripts": {
        "build": "rollup -c",
        "watch": "rollup -c -w",
        "serve": "serve dist -C",
        "develop": "cross-env BUILD_TYPE=debug concurrently --kill-others \"npm run watch\" \"npm run serve\"",
        "develop:auto-launch": "concurrently --kill-others \"xdg-open 'http://localhost:3000/'\" \"npm run watch\" \"npm run serve\"",
        "fmt": "prettier --check \"src/**/*.ts\" global.d.ts eslint.config.mjs prettier.config.mjs rollup.config.mjs",
        "fmt:fix": "prettier --write \"src/**/*.ts\" global.d.ts eslint.config.mjs prettier.config.mjs rollup.config.mjs",
        "lint": "eslint src global.d.ts eslint.config.mjs prettier.config.mjs rollup.config.mjs",
        "lint:fix": "eslint src global.d.ts eslint.config.mjs prettier.config.mjs rollup.config.mjs --fix",
        "lint:locales": "node scripts/check-locales.mjs",
        "test": "tsc -p test/tsconfig.json && node --import ./test/register.mjs test/queue-ordering.mjs"
    },
    "engines": {
        "node": ">=20.19.0"
    },
    "devDependencies": {
        "@playcanvas/eslint-config": "3.0.0",
        "@playcanvas/pcui": "6.2.0",
        "@playcanvas/splat-transform": "3.11.2",
        "@rollup/plugin-alias": "6.0.1",
        "@rollup/plugin-image": "3.0.3",
        "@rollup/plugin-json": "6.1.0",
        "@rollup/plugin-node-resolve": "16.0.3",
        "@rollup/plugin-terser": "1.0.2",
        "@rollup/plugin-typescript": "12.3.1",
        "@types/wicg-file-system-access": "2023.10.7",
        "@webgpu/types": "0.1.74",
        "autoprefixer": "10.6.2",
        "concurrently": "10.0.7",
        "cross-env": "10.1.0",
        "eslint": "10.14.0",
        "i18next": "27.1.1",
        "i18next-browser-languagedetector": "8.3.0",
        "i18next-http-backend": "4.0.10",
        "mediabunny": "1.65.2",
        "playcanvas": "2.24.1",
        "postcss": "8.5.32",
        "prettier": "3.10.1",
        "rollup": "4.68.2",
        "rollup-plugin-scss": "4.0.1",
        "sass": "1.108.2",
        "serve": "14.2.7",
        "tslib": "2.9.1",
        "typescript": "6.0.3"
    }
}
